rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document or is an admin
    function isOwnerOrAdmin(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }

    // 1. Photo sessions collection: Public read for guest QR downloads; create for kiosk captures
    match /photo_sessions/{sessionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 2. User accounts hierarchy: users/{userId}/outlets/{outletId}/events/{eventId}
    match /users/{userId} {
      allow read, write: if isOwnerOrAdmin(userId);

      match /outlets/{outletId} {
        allow read, write: if isOwnerOrAdmin(userId);

        match /events/{eventId} {
          allow read, write: if isOwnerOrAdmin(userId);
        }
      }
    }
    
    // 3. Global / Legacy fallback collections
    match /outlets/{outletId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. Hardware Telemetry pings from kiosk companion daemon
    match /telemetry/{boothId} {
      allow read, write: if true;
    }
  }
}
