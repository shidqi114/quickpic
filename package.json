{
  "name": "quickpic",
  "version": "0.1.2",
  "description": "QuickPic Desktop Photobooth with Canon DSLR & DNP Printer support",
  "author": "QuickPic",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:dist": "next build && electron-builder",
    "electron:dist:win": "next build && electron-builder --win",
    "electron:dist:mac": "next build && electron-builder --mac"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode.react": "^1.0.5",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.11.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.quickpic.photobooth",
    "productName": "QuickPic Photobooth",
    "mac": {
      "category": "public.app-category.photography",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuickPic Photobooth"
    },
    "files": [
      "electron/**/*",
      "hardware-daemon/**/*",
      "public/**/*"
    ]
  }
}
