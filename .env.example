# ============================================================================
# QuickPic Photobooth Ecosystem - Environment Configuration Template
# ============================================================================
# SECURITY NOTICE:
# - Variables prefixed with NEXT_PUBLIC_ are inlined into client-side JavaScript bundles.
#   NEVER prefix private keys, secret keys, or service role credentials with NEXT_PUBLIC_.
# - Server-only secrets MUST remain strictly confidential on backend nodes.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SERVER-ONLY SECRETS (Never expose to client bundles!)
# ----------------------------------------------------------------------------

# Supabase Server-Side Connection (@supabase/server & supabase-js server role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Cloudinary Server Upload Credentials (CDN & Cloud Photo Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# QuickPic Hardware / Kiosk HMAC & Device Token Secrets
# Used to verify tamper-proof telemetry and sign device tokens
DEVICE_TOKEN_SECRET=
HARDWARE_DAEMON_SECRET=

# ----------------------------------------------------------------------------
# 2. CLIENT-EXPOSED KEYS (Safe for browser / Electron runtime)
# ----------------------------------------------------------------------------

# Firebase Client SDK Configuration (Auth, Firestore, Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=quickpic-kiosk.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=quickpic-kiosk
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=quickpic-kiosk.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Public Gallery Base URL (For guest mobile QR codes)
NEXT_PUBLIC_PUBLIC_GALLERY_URL=https://quickpic-olive.vercel.app

# ----------------------------------------------------------------------------
# 3. KIOSK NODE CONFIGURATION (Stored in Electron kiosk local config / env)
# ----------------------------------------------------------------------------
# Assigned physical booth ID and cryptographic bearer token for kiosk desktop
QUICKPIC_BOOTH_ID=booth-jkt-01
QUICKPIC_DEVICE_TOKEN=qp_dev_...
